<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="600dp"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="38dp"
        android:paddingEnd="56dp"
        android:paddingBottom="38dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMARTTUBE  ·  DEBUG UTILITY"
            android:textColor="#AAB2BD"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Resolve source. Play live."
            android:textColor="#F5F7FA"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enter a YouTube live video URL, channel URL, channel ID, or @handle."
            android:textColor="#BEC5CE"
            android:textSize="19sp" />

        <AutoCompleteTextView
            android:id="@+id/sabr_input"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/debug_live_field"
            android:hint="Paste URL, ID, or @handle"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:singleLine="true"
            android:textColor="#F5F7FA"
            android:textColorHint="#7E8792"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="Examples: youtu.be/…  ·  youtube.com/@handle/live  ·  UC…"
            android:textColor="#7E8792"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sabr_load"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/debug_live_button_primary"
                android:text="Resolve and play"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/sabr_refresh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="1.2"
                android:background="@drawable/debug_live_button_secondary"
                android:enabled="false"
                android:text="Refresh resolution"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <Button
                android:id="@+id/sabr_stop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="0.8"
                android:background="@drawable/debug_live_button_secondary"
                android:text="Stop"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/debug_live_panel"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESOLUTION STATUS"
                android:textColor="#8E98A4"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sabr_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="READY"
                android:textColor="#FF4B42"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sabr_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="No channel resolution is active."
                android:textColor="#D5DAE0"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Playback opens in SmartTube's normal full-screen player. Diagnostics never display signed URLs, tokens, cookies, or request bodies."
            android:textColor="#69737E"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
