<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#12161B" />
            <stroke android:width="3dp" android:color="#FF4B42" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#12161B" />
            <stroke android:width="1dp" android:color="#4B535D" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
