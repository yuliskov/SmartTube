<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube-guide style pill: focused = white pill; selected-unfocused = none -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/card_selected_background_white"/><corners android:radius="6dp"/></shape>
    </item>
    <item><shape><solid android:color="@android:color/transparent"/><corners android:radius="6dp"/></shape></item>
</selector>
