<?xml version="1.0" encoding="utf-8"?>
<!-- MOD: Enable single click touch mode (focusableInTouchMode=false) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
              android:focusableInTouchMode="true"
              android:focusable="true"
              android:orientation="vertical"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/settings_image"
        android:layout_width="@dimen/settings_image_size"
        android:layout_height="@dimen/settings_image_size"
        android:layout_gravity="center"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="25dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:visibility="invisible"
        />
    <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.MarqueeTextViewCompat
        android:id="@+id/settings_title"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:layout_width="@dimen/settings_card_width"
        android:layout_height="wrap_content"
        android:padding="@dimen/lb_basic_card_info_padding"
        android:fontFamily="sans-serif-medium"
        android:textSize="15sp"
        android:textAlignment="center"/>
</LinearLayout>
