<?xml version="1.0" encoding="utf-8"?>
<!-- Keeps the ids expected by the control bar: button, icon. The outer frame is the item view of the presenter,
     the bar sizes the inner one (compact buttons) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:ignore="UselessParent">

    <FrameLayout
        android:id="@+id/button"
        android:layout_width="@dimen/modern_player_button"
        android:layout_height="@dimen/modern_player_button"
        android:background="@drawable/modern_player_button_bg"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/modern_player_button_icon"
            android:layout_height="@dimen/modern_player_button_icon"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </FrameLayout>
</FrameLayout>
